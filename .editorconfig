root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Trailing double-space is meaningful in Markdown (hard line break).
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
